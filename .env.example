# Copy to .env and fill in. Never commit .env.

# --- AMD model endpoint: AMD Token Factory (free, shared, OpenAI-compatible) ---
# Redeem your team key at https://notebooks.amd.com/tokenfactory (every teammate must redeem first).
# The whole team shares one key and its limits: 30 requests/min per key, 20/min per account,
# 8 at once, plus a daily spend cap. Send only the synthetic sample invoices, never real financial data.
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_API_KEY=
AMD_MODEL=DeepSeek-V4-Flash
# Optional: none, low, medium, high (thinking tokens count toward max_tokens). Leave empty for the model default.
AMD_REASONING_EFFORT=

# Using your own vLLM droplet on AMD Developer Cloud instead? Set:
# AMD_BASE_URL=http://<DROPLET_IP>:8000/v1
# AMD_API_KEY=<the --api-key you gave vLLM>
# AMD_MODEL=ledgerpilot-model
# (The older VLLM_BASE_URL / VLLM_API_KEY / VLLM_MODEL names still work.)

# --- Evolus event workspace (API keys page shows the space ID = app id) ---
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_AGENT_ID=
# Agent that owns the extractors, if different from the main agent
EVOLUS_EXTRACTOR_AGENT_ID=
EVOLUS_EXTRACTOR_INVOICE_ID=
EVOLUS_EXTRACTOR_PO_ID=
EVOLUS_EXTRACTOR_GRN_ID=
EVOLUS_WORKFLOW_ID=
EVOLUS_LIBRARY_ID=

# --- Business rules ---
PRICE_TOLERANCE=0.00
# Tax above this share of the subtotal is held (0.30 = 30%)
MAX_TAX_RATE=0.30

# --- Optional ---
# Seconds before a slow Evolus call or agent answer hands the case to a person
EVOLUS_TIMEOUT=90
AGENT_TIMEOUT=90
