# Copy to .env and fill in. Never commit .env.

# --- AMD Developer Cloud: your vLLM endpoint on the MI300X droplet ---
VLLM_BASE_URL=http://<DROPLET_IP>:8000/v1
VLLM_API_KEY=
VLLM_MODEL=ledgerpilot-model

# --- Evolus event workspace (API keys page shows the space ID = app id) ---
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_AGENT_ID=
# Agent that owns the extractors, if different from the main agent
EVOLUS_EXTRACTOR_AGENT_ID=
EVOLUS_EXTRACTOR_INVOICE_ID=
EVOLUS_EXTRACTOR_PO_ID=
EVOLUS_EXTRACTOR_GRN_ID=
EVOLUS_WORKFLOW_ID=
EVOLUS_LIBRARY_ID=

# --- Business rules ---
PRICE_TOLERANCE=0.00
# Tax above this share of the subtotal is held (0.30 = 30%)
MAX_TAX_RATE=0.30

# --- Optional ---
# Seconds before a slow Evolus call or agent answer hands the case to a person
EVOLUS_TIMEOUT=90
AGENT_TIMEOUT=90
